# Copy to .env.development / .env.production for local use, and set the same names in
# Netlify (Site configuration > Environment variables). Never commit real values.

# Newsletter (feature: newsletter sign-up)
# Show the sign-up forms. Read at build time, so rebuild after changing it.
GATSBY_NEWSLETTER_ENABLED=false
# Buttondown API key (https://buttondown.com/requests). Server-side only: used by
# src/api/newsletter/subscribe.js, never sent to the browser.
BUTTONDOWN_API_KEY=
# Optional: pin Buttondown's API version, e.g. 2026-11-10
BUTTONDOWN_API_VERSION=
# Optional: provider adapter name in src/services/newsletter (default: buttondown)
NEWSLETTER_PROVIDER=

# Photo scanning on /pantry (feature: ingredient recommendations)
# Show the "Photo of food" / "Shopping list" buttons. Read at build time.
GATSBY_PANTRY_SCAN_ENABLED=false
# Anthropic API key. Server-side only: used by src/api/pantry/scan.js.
ANTHROPIC_API_KEY=

# Community recipes (feature: user-contributed recipes, Supabase)
# Project URL and publishable key (public by design; access is enforced by the database
# rules in supabase/migrations). Leave empty to hide sign-in and submissions.
GATSBY_SUPABASE_URL=
GATSBY_SUPABASE_PUBLISHABLE_KEY=
# Secret key. Server-side only (src/api/recipes/publish.js): copies a published recipe's
# photo into public storage. In Netlify, scope it to Functions. Never prefix with GATSBY_.
SUPABASE_SECRET_KEY=
# Netlify build hook, called after publishing or unpublishing so the site rebuilds.
NETLIFY_BUILD_HOOK_URL=
